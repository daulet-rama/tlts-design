content.json
**/shots/*.png
assets/3d/**/src/
.DS_Store

# служебное, сайту не нужно — не публикуется
__pycache__/
*.pyc
live/**/tests/
live/**/tools/
live/core/kit.html
live/core/kit-bar.html
live/core/API.md
live/core/LOOK.md

# настоящие люди лиги для вида директора на «Признании» — только на своём компьютере
live/ideas/honors.people.js

# макеты новой главной (папки net-*): публикуются только страница, скрипты и стили
net-*/**/profile/
net-*/**/prof-*/
net-*/**/scratch/
net-*/**/shots*/
net-*/**/tools/
net-*/**/*.md
net-*-check*/
net-court-checks/
_critics/
_checks/
_merged-checks/

# промежуточные макеты и образцы для сверки — остаются на своём компьютере
net-readability/
net-balls/
net-themes/
net-home/
net-home-approved-v1/
net-court-a-v1/
net-court-b-approved-v1/
net-court-journey-v1/
net-court-b-v21/
net-court-b-v22/
net-court-b-try/
net-court-journey-try/

# макеты мобильной платформы — пока только на своём компьютере
mobile-*/

# макеты приложения — пока только на своём компьютере
app-*/

# раздел организатора (admin-v1): выкладывается без служебного — заметок, снимков, списка экранов, листа деталей
admin-*/
!admin-v1/
admin-v1/shots/
admin-v1/*.md
admin-v1/screens.json
admin-v1/kit.html

# страницы приложения app-v2 — для предпросмотра «Так увидят» в разделе организатора; служебное не выкладывается
!app-v2/
app-v2/shots/
app-v2/*.md
app-v2/screens.json
app-v2/kit.html
app-v2/idea-*
app-v2/css/idea-*
app-v2/js/idea-*
